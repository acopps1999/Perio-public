{
  "name": "clinical-chart",
  "version": "1.0.0",
  "private": true,
  "_comment": "Force fresh deployment",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-select": "^1.0.4",
    "@radix-ui/react-tabs": "^1.0.4",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^1.2.1",
    "dotenv": "^16.5.0",
    "lucide-react": "^0.257.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.2",
    "react-scripts": "5.0.1",
    "serve": "^14.2.4",
    "tailwindcss": "^3.3.2",
    "uuid": "^11.1.0"
  },
  "scripts": {
    "start": "serve -s build -p ${PORT:-10000}",
    "dev": "react-scripts start",
    "build": "NODE_OPTIONS='--max_old_space_size=4096' react-scripts build",
    "build:prod": "NODE_ENV=production GENERATE_SOURCEMAP=false NODE_OPTIONS='--max_old_space_size=4096' react-scripts build",
    "build:analyze": "npm run build:prod && npx serve -s build",
    "test": "react-scripts test",
    "test:prod": "CI=true npm run test -- --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "deploy": "npm run build:prod && echo 'Build complete - ready for deployment'",
    "health-check": "node -e \"console.log('Health check passed')\""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^4.6.2",
    "firebase-admin": "^13.4.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
